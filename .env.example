# RuralShield AI Environment Configuration Template
# Copy this file to .env and configure your secrets securely. Never commit .env to version control!

# Flask / Express Session Security
SECRET_KEY="replace-with-a-cryptographically-secure-random-string-min-32-chars"

# Database Configuration (MongoDB)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="ruralshield_ai"

# Initial Authorized Administrator Bootstrap
INITIAL_ADMIN_EMAIL="sherasanjayn@gmail.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# WebAuthn / Passkey Relying Party Configuration
# For local development: rp_id="localhost", permitted_origin="http://localhost:3000"
# For production HTTPS: rp_id="ruralshield.example.com", permitted_origin="https://ruralshield.example.com"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="RuralShield AI"
WEBAUTHN_ORIGIN="http://localhost:3000"

# TOTP Security Configuration
# 32-byte hex-encoded key for AES-256-GCM encryption of stored TOTP secrets
TOTP_ENCRYPTION_KEY="replace-with-64-character-hex-string-for-aes-256"

# Session Expiry (Seconds)
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=86400

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_CHALLENGE_MAX=10
RATE_LIMIT_CHALLENGE_WINDOW_SEC=60

# Application Environment (development or production)
ENVIRONMENT="development"
PORT=3000

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
